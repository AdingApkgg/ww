{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "esModuleInterop": true,
    "types": ["bun", "vite/client"], "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "server", "shared", "scripts", "tests", "e2e", "*.ts"]
}
