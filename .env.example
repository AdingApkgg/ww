# Local Mac: no .env file is required. Install Wine first, then bun install && bun run dev.
# Docker: copy this file to .env and fill in BOTH values below.
WW_ADMIN_TOKEN=
WW_ORIGIN=http://localhost:4387

# Optional host settings (Mac/Linux native deployment):
# WW_WINE_BIN=/absolute/path/to/wine
# WW_WINESERVER_BIN=/absolute/path/to/matching/wineserver
# WW_WINETRICKS_BIN=/absolute/path/to/winetricks
# WW_DATA_DIR=/absolute/path/to/workspace-data
# WW_HOST=127.0.0.1
# WW_PORT=4387
# WW_WEB_PORT=5173
# WW_DESKTOP_URL=http://127.0.0.1:6080

# Optional Docker port publishing (loopback by default):
# WW_BIND_ADDRESS=0.0.0.0
# WW_PUBLISHED_PORT=4387
